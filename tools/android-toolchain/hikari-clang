#!/usr/bin/env bash
#
# hikari-clang — Android NDK clang driver with Hikari obfuscation passes.
#
# Android NDK clang (LLVM 21) and this plugin (LLVM 22) cannot share a process:
# LLVM has no stable plugin ABI, so a plugin built for LLVM 22 must be loaded by
# an LLVM 22 host.  Instead of rebuilding clang, this wrapper splits the compile
# into three stages so that only IR crosses the version boundary:
#
#   1. <ndk>/bin/clang  -emit-llvm -S src.c -o src.ll          (LLVM 21)
#   2. opt-22 -load-pass-plugin=libHikari.so --passes=… -S     (LLVM 22 obfuscates)
#   3. <ndk>/bin/clang  src.obf.ll -o src.o / link             (LLVM 21)
#
# Every hand-off is *text* IR, and both halves of that matter.  The stages are
# one version apart, and X.llvm bitcode only reads in one direction — a newer
# release reads what an older one wrote, never the reverse, and stage 2 is the
# newer tool.  Two distinct failures follow from handing over the wrong way, and
# each was measured against the NDK's clang 21 and LLVM 22.1.8 rather than
# assumed:
#
#   * Bitcode out of stage 2 dies in stage 3 with "error: Invalid record"
#     whenever the module carries debug info: LLVM 22 encodes that metadata with
#     records LLVM 21 has no reader for.  A plain -O0 module happens to use
#     records LLVM 21 still knows, which is exactly why this hid for so long —
#     every `-g` build was broken while every release build was fine.
#   * Text out of stage 2 whose *input* was bitcode dies too: a module read from
#     bitcode has explicit per-location memory effects, so LLVM 22 prints them
#     as `memory(read, target_mem0: none, target_mem1: none)` — a location
#     spelling LLVM 21's parser rejects.  Parse the same module from text and
#     the same pass prints `memory(read)`.
#
# So stage 1 emits text as well: text in, text out keeps the attribute spelling
# compact and debug info intact, and no bitcode ever crosses the boundary.  The
# cost is re-parsing text instead of bitcode, ~0.4s per translation unit for opt
# (0.22s vs 0.20s) and clang (0.44s vs 0.06s on a 2MB module) — not worth losing
# debug builds, or silently rewriting function attributes, over.
#
# The product is still an ordinary NDK build artifact: same target, same ABI,
# same runtime — only the IR ran through Hikari.
#
# Environment
#   HIKARI_NDK       Path to an Android NDK.  Optional in a packaged --full
#                    toolchain, which carries its own NDK under ../ndk/.
#   HIKARI_CC        Explicit clang to use instead of the NDK's.
#   HIKARI_PLUGIN    libHikari.so.  Defaults to ../lib/, then build/obfuscation/.
#   HIKARI_OPT       LLVM 22 `opt`.  Defaults to ../llvm/bin/opt, then PATH.
#   HIKARI_PASSES    Pipeline, e.g. 'hikari(enable-vmp,enable-cffobf)'.
#   HIKARI_OBF       0 (or "off") = pure passthrough to clang.
#   HIKARI_OPT_LEVEL Stage-1 opt level; defaults to -O0 (Hikari targets -O0 IR).
#   HIKARI_SEED      Integer PRNG seed (LLVM -aesSeed).  The obfuscator seeds
#                    itself from the wall clock by default, so pinning this
#                    gives byte-reproducible output and lets a failing build be
#                    replayed exactly.
#   HIKARI_VERBOSE   1 = echo each stage.
#
# Exit codes follow clang's.

set -euo pipefail

# Plain "${arr[@]}" on an empty array is only expansion-safe (no stray empty
# word under `set -u`) from bash 4.4 on.
if [[ "${BASH_VERSINFO[0]:-0}" -lt 4 ||
      ( "${BASH_VERSINFO[0]:-0}" -eq 4 && "${BASH_VERSINFO[1]:-0}" -lt 4 ) ]]; then
    printf 'hikari-clang: bash >= 4.4 required (found %s)\n' "${BASH_VERSION:-unknown}" >&2
    exit 1
fi

die() { printf 'hikari-clang: %s\n' "$*" >&2; exit 1; }
log() { [[ "${HIKARI_VERBOSE:-0}" == "1" ]] && printf 'hikari-clang: %s\n' "$*" >&2; return 0; }

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HIKARI_ROOT="${HIKARI_ROOT:-$(cd "$SELF_DIR/../.." && pwd)}"

# ---------------------------------------------------------------- locators ---
first_existing() {
    local c
    for c in "$@"; do
        [[ -n "$c" && -f "$c" ]] && { printf '%s' "$c"; return 0; }
    done
    return 1
}

find_opt() {
    if [[ -n "${HIKARI_OPT:-}" ]]; then
        [[ -x "$HIKARI_OPT" ]] || die "HIKARI_OPT=$HIKARI_OPT is not executable"
        printf '%s' "$HIKARI_OPT"; return 0
    fi
    local hit
    if hit="$(first_existing \
        "$SELF_DIR/../llvm/bin/opt" \
        "$SELF_DIR/../lib/llvm/bin/opt" \
        "$HIKARI_ROOT/build/llvm/bin/opt")"; then
        printf '%s' "$hit"; return 0
    fi
    if command -v opt-22 >/dev/null 2>&1; then command -v opt-22; return 0; fi
    if command -v opt >/dev/null 2>&1; then command -v opt; return 0; fi
    return 1
}

find_clang() {
    if [[ -n "${HIKARI_CC:-}" ]]; then
        printf '%s' "$HIKARI_CC"; return 0
    fi
    if [[ -n "${HIKARI_NDK:-}" ]]; then
        local hit
        if hit="$(first_existing \
            "$HIKARI_NDK/toolchains/llvm/prebuilt/linux-x86_64/bin/clang" \
            "$HIKARI_NDK/toolchains/llvm/prebuilt/darwin-x86_64/bin/clang" \
            "$HIKARI_NDK/toolchains/llvm/prebuilt/darwin-arm64/bin/clang" \
            "$HIKARI_NDK/toolchains/llvm/prebuilt/windows-x86_64/bin/clang.exe")"; then
            printf '%s' "$hit"; return 0
        fi
        die "no clang under HIKARI_NDK=$HIKARI_NDK (expected toolchains/llvm/prebuilt/*/bin/clang)"
    fi
    # Packaged --full toolchain: the NDK prebuilt tree travels with this script,
    # so the machine doing the build needs neither an NDK nor an NDK path.
    local bundled
    for bundled in "$SELF_DIR"/../ndk/toolchains/llvm/prebuilt/*/bin/clang; do
        [[ -x "$bundled" ]] && { printf '%s' "$bundled"; return 0; }
    done
    if [[ -x "$SELF_DIR/../clang-real" ]]; then
        printf '%s' "$SELF_DIR/../clang-real"; return 0
    fi
    if command -v clang >/dev/null 2>&1; then command -v clang; return 0; fi
    return 1
}

PLUGIN="$(first_existing \
    "${HIKARI_PLUGIN:-}" \
    "$SELF_DIR/../lib/libHikari.so" \
    "$SELF_DIR/../lib/libHikari.dylib" \
    "$HIKARI_ROOT/build/obfuscation/libHikari.so" \
    "$HIKARI_ROOT/build/obfuscation/libHikari.dylib" \
    "$HIKARI_ROOT/build-llvm22/obfuscation/libHikari.so" \
    "$HIKARI_ROOT/build-llvm22/obfuscation/libHikari.dylib")" \
    || die "libHikari plugin not found (set HIKARI_PLUGIN=/path/to/libHikari.so)"

CLANG="$(find_clang)" || die "clang not found (set HIKARI_NDK or HIKARI_CC)"

PASSES="${HIKARI_PASSES:-hikari(enable-bcfobf,enable-cffobf,enable-subobf,enable-splitobf,enable-strcry,enable-indibran,enable-fco)}"
OPT_LEVEL="${HIKARI_OPT_LEVEL:--O0}"

SEED_ARGS=()
if [[ -n "${HIKARI_SEED:-}" ]]; then
    [[ "$HIKARI_SEED" =~ ^[0-9]+$ ]] || die "HIKARI_SEED must be a non-negative integer"
    SEED_ARGS=(-aesSeed="$HIKARI_SEED")
fi

# Note: no --sysroot is passed on purpose.  An NDK clang derives its sysroot from
# its own location — which is what lets the bundled copy work from any path — and
# forcing one would make host-triple compiles (the driver's default target) pick
# up Android headers.  `hikari-clang -c foo.c` equals plain NDK clang.

# ------------------------------------------------------------ passthrough? ---
if [[ "${HIKARI_OBF:-1}" == "0" || "${HIKARI_OBF:-1}" == "off" ]]; then
    exec "$CLANG" "$@"
fi

ARGS=("$@")
[[ ${#ARGS[@]} -eq 0 ]] && exec "$CLANG"

OPT="$(find_opt)" || die "LLVM 22 'opt' not found (set HIKARI_OPT=/path/to/opt)"

# ------------------------------------------------------------------ parse ---
FWD=()              # flags forwarded to clang in every stage
DEPF=()             # dependency-generation flags (stage 1 only)
SOURCES=()          # translatable C/C++ sources
BC_INPUTS=()        # .bc/.ll inputs (obfuscated directly)
OTHER_INPUTS=()     # .o/.a/.so/.s inputs — passed through untouched
OUTPUT=""
MODE=link           # link | compile | passthrough
DEP_WANTS=0         # -M / -MM (imply -E)

need_val() { [[ $# -ge 2 ]] || die "$1 requires an argument"; }

i=0
while (( i < ${#ARGS[@]} )); do
    a="${ARGS[$i]}"
    case "$a" in
        -c) MODE=compile ;;
        -E|-fsyntax-only|-print-*|--version|-v|--help|-emit-llvm) MODE=passthrough ;;
        -M|-MM) MODE=passthrough; DEP_WANTS=1 ;;
        -MD|-MMD|-MP|-MG) DEPF+=("$a") ;;
        -MF|-MT|-MQ) need_val "$a" "${ARGS[@]:$((i+1))}"
                     DEPF+=("$a" "${ARGS[$((i+1))]}"); i=$((i+2)); continue ;;
        -o) need_val "$a" "${ARGS[@]:$((i+1))}"; OUTPUT="${ARGS[$((i+1))]}"; i=$((i+2)); continue ;;
        -o*) OUTPUT="${a#-o}" ;;
        -x) need_val "$a" "${ARGS[@]:$((i+1))}"
            FWD+=("$a" "${ARGS[$((i+1))]}"); i=$((i+2)); continue ;;
        # LTO replaces the IR pipeline with the link-time plugin: Hikari cannot
        # run there, and silently dropping it would hide the obfuscation gap.
        -flto|-flto=*|-fuse-ld=*) printf 'hikari-clang: dropping %s (incompatible with IR pass pipeline)\n' "$a" >&2 ;;
        *.c|*.cc|*.cp|*.cpp|*.cxx|*.c++|*.C|*.i|*.ii|*.m|*.mm) SOURCES+=("$a") ;;
        *.bc|*.ll) BC_INPUTS+=("$a") ;;
        *.o|*.a|*.so|*.so.*|*.lo|*.s|*.S) OTHER_INPUTS+=("$a"); MODE=link ;;
        *) FWD+=("$a") ;;
    esac
    i=$((i+1))
done

# Nothing to hook (syntax check / preprocess / explicit bitcode output).
if [[ "$MODE" == "passthrough" && ${#SOURCES[@]} -eq 0 && ${#BC_INPUTS[@]} -eq 0 ]]; then
    exec "$CLANG" "${ARGS[@]}"
fi

# Pure link line (objects and archives only).
if [[ ${#SOURCES[@]} -eq 0 && ${#BC_INPUTS[@]} -eq 0 ]]; then
    exec "$CLANG" "${ARGS[@]}"
fi

log "clang:   $CLANG"
log "opt:     $OPT"
log "plugin:  $PLUGIN"
log "passes:  $PASSES"
log "seed:    ${HIKARI_SEED:-(time-based)}"

TMP="$(mktemp -d "${TMPDIR:-/tmp}/hikari-clang.XXXXXX")"
trap 'rm -rf "$TMP"' EXIT

# `-O0` alone still tags every function `optnone`, which makes LLVM skip passes
# on it; -disable-O0-optnone is what lets Hikari touch -O0 code.
STAGE1_EXTRA=(-Xclang -disable-O0-optnone)
for f in "${FWD[@]}"; do
    case "$f" in -O0|-O1|-O2|-O3|-Os|-Oz|-Ofast) STAGE1_EXTRA=(-Xclang -disable-O0-optnone); break ;; esac
done
[[ "$DEP_WANTS" == "1" ]] && STAGE1_EXTRA+=("-O0")

# Stage 3 only has to *print* the mangled IR, so never let clang 21 re-run its
# optimizer over it.  A module written by LLVM 22 can contain IR that LLVM 21's
# passes do not survive, and the failure is a hard crash, not a diagnostic:
#
#   clang++ --target=aarch64-linux-android21 -O2 -c obf.ll
#   -> PLEASE submit a bug report ...
#      Running pass "sroa<modify-cfg>" on function "_ZN7android6detail7String8C2EPKc"
#      (null deref)   [Android NDK r29 clang 21.0.0, LLVM 22.1.8 opt]
#
# -O0 skips those passes and still lowers/codegens the module correctly, and no
# optimization is lost: the source was already optimized in stage 1, which is
# where the -O level belongs.  Appended *after* the forwarded flags so that the
# caller's own -O2 cannot win.
STAGE3_EXTRA=(-O0)

# Packaged toolchains ship LLVM's runtime next to opt; point the loader at it so
# the archive works on a machine without libLLVM.so.22 installed.
for _l in "$SELF_DIR/../llvm/lib" "$SELF_DIR/../lib/llvm/lib"; do
    [[ -d "$_l" ]] && export LD_LIBRARY_PATH="$_l${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
done
unset _l

# A module that came from bitcode carries explicit per-location memory effects,
# which LLVM 22 prints as `memory(read, target_mem0: none, target_mem1: none)` —
# spelling LLVM 21's parser rejects (it knows argmem and inaccessiblemem only),
# so stage 3 would refuse the file.  Stage 1 emits text precisely so this does
# not happen, but the explicit `.bc` input path can still arrive this way.
#
# Dropping a `target_memN: none` clause is not a semantic change: it restates the
# default that the location is untouched, so a reader that has never heard of the
# location evaluates the attribute exactly as before.  Only attribute-group lines
# are rewritten (never string data or instruction text), and a clause claiming a
# real effect is deliberately left alone so the build fails loudly instead of
# silently weakening an attribute.
# LLVM 22 writes attribute spellings the LLVM 21 parser does not know.  Two
# have been seen on real C++ (exceptions + RTTI, system headers):
#
#   target_memN: none      -> memory(...) clause with a location LLVM 21 lacks
#   nocreateundeforpoison  -> attribute name added after LLVM 21
#
# Both surface as `error: unterminated attribute group` pointing at the token.
# Dropping them is not a semantic change: `target_memN: none` restates that the
# location is untouched, and `nocreateundeforpoison` only permits an optimization
# that already happened in stage 1.  A clause claiming a *real* effect is left
# alone so a genuine mismatch fails loudly instead of being silently weakened.
#
# Attributes inside a group are space separated, so the separator cannot be
# assumed to be a comma -- the previous comma-only pattern missed a token that
# was not the first in the group.
UNKNOWN_ATTRS='[ ,]+(target_mem[0-9]+: none|nocreateundeforpoison)\b'

normalize_attrs() { # <file.ll>
    sed -i -E "/^attributes #[0-9]+ = \{/ s/${UNKNOWN_ATTRS}//g" "$1"
}

# Emits text IR: see the note at the top of this file for why bitcode and text
# are not interchangeable across the version boundary.  Callers pass a .ll
# output path.
obf_bc() { # <in.ll> <out.ll>
    log "opt $2"
    "$OPT" -load-pass-plugin="$PLUGIN" --passes="$PASSES" "${SEED_ARGS[@]}" \
        "$1" -S -o "$2"
    normalize_attrs "$2"
}

# A module that arrives as bitcode prints its memory attributes in LLVM 22's
# `target_memN` spelling, which stage 3 cannot parse; re-emitting it as text
# first normalises that (see the note at the top of this file).  Cheap, and only
# on the explicit .bc input path.
to_text() { # <in.bc|in.ll> <out.ll>
    case "$1" in
        *.bc) "$OPT" -S "$1" -o "$2" || die "could not read bitcode: $1" ;;
        *)    cp -f "$1" "$2" ;;
    esac
}

# ------------------------------------------------------- stage 1 + 2: .bc ---
OBF_IR=()    # obfuscated IR, in input order
IR_SRC=()    # the input each entry came from, so -c can name its object
n=0
for src in "${SOURCES[@]}"; do
    [[ -n "$src" ]] || continue
    ir="$TMP/s$n.ll"
    log "ir $src"
    "$CLANG" "${FWD[@]}" "${DEPF[@]}" "$OPT_LEVEL" "${STAGE1_EXTRA[@]}" -emit-llvm -S "$src" -o "$ir"
    obf_bc "$ir" "$TMP/s$n.obf.ll"
    OBF_IR+=("$TMP/s$n.obf.ll")
    IR_SRC+=("$src")
    n=$((n+1))
done

for src in "${BC_INPUTS[@]}"; do
    [[ -n "$src" ]] || continue
    to_text "$src" "$TMP/b$n.in.ll"
    obf_bc "$TMP/b$n.in.ll" "$TMP/b$n.obf.ll"
    OBF_IR+=("$TMP/b$n.obf.ll")
    IR_SRC+=("$src")
    n=$((n+1))
done

# ----------------------------------------------------------- stage 3: out ---
if [[ "$MODE" == "compile" ]]; then
    # One translation unit and an explicit -o: hand clang the path.  Keying this
    # off the source list alone sent `-c file.bc -o out.o` down the multi-source
    # path below, which derives the name from the source and dropped -o entirely
    # (the object landed in ./s0.o).
    if [[ -n "$OUTPUT" && ${#OBF_IR[@]} -eq 1 ]]; then
        log "object $OUTPUT"
        exec "$CLANG" "${FWD[@]}" "${STAGE3_EXTRA[@]}" -c "${OBF_IR[0]}" -o "$OUTPUT"
    fi
    [[ -n "$OUTPUT" ]] && die "-c with several translation units cannot use -o"
    # Several sources with -c: clang drops one .o per source into the cwd, named
    # after that source.  Deriving the name from $SOURCES indexed the wrong list
    # whenever a .ll/.bc input was involved (those live in $BC_INPUTS and are
    # appended after the sources), which quietly wrote ./s0.o instead of ./a.o.
    for idx in "${!OBF_IR[@]}"; do
        out="$(basename "${IR_SRC[$idx]:-s$idx}")"
        out="${out%.*}.o"
        log "object $out"
        "$CLANG" "${FWD[@]}" "${STAGE3_EXTRA[@]}" -c "${OBF_IR[$idx]}" -o "$out"
    done
    exit 0
fi

# Compile + link in a single invocation.
LINK=("${FWD[@]}" "${STAGE3_EXTRA[@]}" "${OBF_IR[@]}")
[[ ${#OTHER_INPUTS[@]} -gt 0 ]] && LINK+=("${OTHER_INPUTS[@]}")
[[ -n "$OUTPUT" ]] && LINK+=(-o "$OUTPUT")
exec "$CLANG" "${LINK[@]}"
